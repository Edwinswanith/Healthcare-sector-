# Public site URL used for canonical links, sitemap and Open Graph (no trailing slash).
NEXT_PUBLIC_SITE_URL=
# Set to "true" only on the production deployment. Anything else adds noindex.
NEXT_PUBLIC_ALLOW_INDEXING=
# Confirmed enquiry address. Leave empty until confirmed: the form then reports
# honestly that it is not connected and sends nothing.
NEXT_PUBLIC_ENQUIRY_EMAIL=
# Server-side only, used by scripts/media generation scripts. Never exposed to the browser.
GEMINI_API_KEY=
